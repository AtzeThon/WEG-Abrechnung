# Kopie als .env anlegen und Werte anpassen. Alle Variablen mit Prefix WEG_.

# Pfad zur SQLite-Datenbankdatei (Default: data/weg.db im Projektverzeichnis)
WEG_DATABASE_PATH=./data/weg.db

# Verwalter-Login. Standard: aus (die App ist offen zugänglich – gedacht für den
# Betrieb im vertrauten Netz, z. B. nur über Tailscale erreichbar).
# Auf true setzen, wenn ein Login gewünscht ist; dann WEG_SECRET_KEY setzen und
# einen Account anlegen: python -m app.cli create-admin <name>
WEG_REQUIRE_LOGIN=false

# Nur nötig bei WEG_REQUIRE_LOGIN=true:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEG_SECRET_KEY=

# Session-Cookie nur über HTTPS ausliefern (bei aktivem Login hinter Caddy: true)
WEG_SECURE_COOKIES=false

# Anzeige
WEG_LOCALE=de_DE
WEG_TIMEZONE=Europe/Berlin

# Debugmodus (SQL-Echo etc.)
WEG_DEBUG=false
