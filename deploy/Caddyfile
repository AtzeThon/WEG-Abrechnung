# Caddy als Reverse-Proxy mit automatischem HTTPS.
#
# Variante A – eigene (Sub-)Domain mit öffentlichem DNS (Let's Encrypt):
#   Domain unten eintragen, Ports 80/443 müssen erreichbar sein.
#
# Variante B – Zugriff nur über Tailscale (empfohlen für Finanzdaten):
#   Statt dieser Datei genügt:
#       tailscale serve --bg 8000
#   Tailscale stellt HTTPS über den MagicDNS-Namen bereit; Caddy wird nicht
#   benötigt. Alternativ hier den MagicDNS-Namen als Domain eintragen und
#   "tls internal" verwenden.

weg.example.org {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000

    # größere Uploads sind nicht vorgesehen
    request_body {
        max_size 5MB
    }

    header {
        Referrer-Policy "same-origin"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }

    log {
        output file /var/log/caddy/weg-abrechnung.log
        format console
    }
}

# --- Variante B (Tailscale, internes Zertifikat) --------------------------
# meinpi.mein-tailnet.ts.net {
#     tls internal
#     reverse_proxy 127.0.0.1:8000
# }
